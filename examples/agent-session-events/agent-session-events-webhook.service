[Unit]
Description=Agent-session GitHub webhook receiver
After=network.target

[Service]
Type=simple
User=agent-session-events-webhook
Group=agent-session-events-webhook
SupplementaryGroups=agent-session-events-db
UMask=0007
EnvironmentFile=/etc/agent-session-events/webhook.env
ExecStart=/usr/local/bin/agent-session-events serve --config /etc/agent-session-events/events.toml
Restart=on-failure
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/agent-session-events

[Install]
WantedBy=multi-user.target
