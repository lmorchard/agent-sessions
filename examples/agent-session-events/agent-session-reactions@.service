[Unit]
Description=Agent-session approval-reaction poll pass (%i)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=agent-session-events-reactions
Group=agent-session-events-reactions
SupplementaryGroups=agent-session-events-db
UMask=0007
EnvironmentFile=/etc/agent-session-events/reactions-%i.env
ExecStart=/usr/local/bin/agent-session-events poll-reactions --config /etc/agent-session-events/events.toml
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/agent-session-events
