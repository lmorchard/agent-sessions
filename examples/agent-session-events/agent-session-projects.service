[Unit]
Description=Agent-session Projects poll pass
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=agent-session-events-projects
Group=agent-session-events-projects
SupplementaryGroups=agent-session-events-db
UMask=0007
EnvironmentFile=/etc/agent-session-events/projects.env
ExecStart=/usr/local/bin/agent-session-events poll-projects --config /etc/agent-session-events/events.toml
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/agent-session-events
